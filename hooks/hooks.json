{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(printf '%s' \"${CLAUDE_PLUGIN_ROOT}\" | sed 's#\\\\#/#g; s#^\\([A-Za-z]\\):/#/mnt/\\L\\1/#')/hooks/honey-session.js\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(printf '%s' \"${CLAUDE_PLUGIN_ROOT}\" | sed 's#\\\\#/#g; s#^\\([A-Za-z]\\):/#/mnt/\\L\\1/#')/hooks/honey-subagent.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(printf '%s' \"${CLAUDE_PLUGIN_ROOT}\" | sed 's#\\\\#/#g; s#^\\([A-Za-z]\\):/#/mnt/\\L\\1/#')/hooks/logcompress-hook.js\""
          }
        ]
      }
    ]
  }
}
